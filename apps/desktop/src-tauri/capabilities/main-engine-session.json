{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-engine-session",
  "description": "Fixed private native transport from the trusted main document. Credentials and arbitrary URLs are never exposed.",
  "local": true,
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": ["allow-get-engine-session", "allow-engine-request-open", "allow-engine-upload-chunk", "allow-engine-upload-finish", "allow-engine-response-head", "allow-engine-response-read", "allow-engine-request-abort", "allow-engine-request-release", "allow-owner-setup-prepare", "allow-owner-setup-present", "allow-owner-setup-status", "allow-owner-setup-abort"]
}
